{
  "name": "vault-health",
  "version": "0.1.0",
  "description": "Local-first diagnostic system for Obsidian vaults: research integrity, knowledge structure, source provenance, art & media health.",
  "main": "main.js",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check-api": "node scripts/check-api-since.mjs node_modules/obsidian/obsidian.d.ts"
  },
  "engines": { "node": ">=22.18" },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "typescript": "^5.8.0"
  }
}
